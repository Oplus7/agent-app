# 云端模型密钥（可选，仅 deepseek-flash 路由需要）
DEEPSEEK_API_KEY=sk-xxx

# LiteLLM 网关地址
LITELLM_BASE_URL=http://localhost:4000/v1
LLM_BASE_URL=http://localhost:4000/v1

# 模型别名（与 litellm_config.yaml 一致）
MODEL_LOCAL=ollama-chat
MODEL_CLOUD=deepseek-flash
LLM_MODEL=ollama-chat

# local-rag 知识库
RAG_URL=http://localhost:8100

# ToolHub 允许访问的目录（分号分隔）
TOOLHUB_ROOTS=C:\Users\YourName\Downloads;D:\AI_Control;G:\FUNASR
